{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information in the VENDA AQUI marketplace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_]+$" },
        "email": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 500000 },
        "coverPhoto": { "type": "string", "maxLength": 500000 },
        "bio": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "rating": { "type": "number" },
        "totalSales": { "type": "number" },
        "reviewCount": { "type": "number" },
        "verified": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "isAdmin": { "type": "boolean" },
        "isBlocked": { "type": "boolean" },
        "blockedUserIds": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "username", "email"]
    },
    "Post": {
      "title": "Post",
      "description": "Product listing publication in VENDA AQUI feed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string", "maxLength": 100 },
        "sellerUsername": { "type": "string", "maxLength": 50 },
        "sellerAvatar": { "type": "string", "maxLength": 500000 },
        "sellerLocation": { "type": "string", "maxLength": 100 },
        "sellerVerified": { "type": "boolean" },
        "title": { "type": "string", "maxLength": 150 },
        "price": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "condition": { "type": "string", "enum": ["novo", "usado"] },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "images": { "type": "array" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" },
        "commentsCount": { "type": "number" },
        "location": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["disponivel", "reservado", "vendido"] },
        "buyerId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sellerId", "title", "price", "condition", "description"]
    },
    "Report": {
      "title": "Report",
      "description": "Report submitted by users against suspicious listings or users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterName": { "type": "string", "maxLength": 100 },
        "targetType": { "type": "string", "enum": ["post", "user"] },
        "targetId": { "type": "string" },
        "targetTitle": { "type": "string", "maxLength": 150 },
        "targetUserId": { "type": "string" },
        "reason": { "type": "string", "enum": ["golpe", "conteudo_ofensivo", "produto_proibido", "outro"] },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pendente", "resolvido", "descartado"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "reason"]
    },
    "Review": {
      "title": "Review",
      "description": "Buyer rating and review for a seller after transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string", "maxLength": 100 },
        "buyerUsername": { "type": "string", "maxLength": 50 },
        "buyerAvatar": { "type": "string", "maxLength": 500000 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 500 },
        "productId": { "type": "string" },
        "productTitle": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sellerId", "buyerId", "rating", "comment"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User question or comment on a listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorAvatar": { "type": "string", "maxLength": 500000 },
        "text": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "authorId", "text"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct chat between buyer and seller",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array" },
        "productId": { "type": "string" },
        "productTitle": { "type": "string", "maxLength": 150 },
        "productPrice": { "type": "number" },
        "productImage": { "type": "string", "maxLength": 500000 },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastMessageTime": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participantIds"]
    },
    "Message": {
      "title": "Message",
      "description": "Single message inside a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "offerPrice": { "type": "number" }
      },
      "required": ["id", "senderId", "text"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification for likes, messages, offers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["like", "comment", "message", "offer", "sale", "review"] },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" },
        "postId": { "type": "string" },
        "userAvatar": { "type": "string", "maxLength": 500000 }
      },
      "required": ["id", "userId", "type", "title"]
    },
    "Shop": {
      "title": "Shop",
      "description": "Store or business profile in VENDA AQUI (shops, lojas, mercearias, barracas, prestadores de serviços)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "shopType": { 
          "type": "string", 
          "enum": [
            "Roupa e calçados",
            "Eletrónicos e telemóveis",
            "Supermercado e mercearia",
            "Material de construção",
            "Cosméticos e beleza",
            "Móveis e casa",
            "Peças e oficinas",
            "Alimentação e restaurantes",
            "Serviços (reparações, transporte, etc.)",
            "Outros"
          ] 
        },
        "city": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "openingHours": { "type": "string", "maxLength": 100 },
        "hasDelivery": { "type": "boolean" },
        "logo": { "type": "string", "maxLength": 500000 },
        "coverPhoto": { "type": "string", "maxLength": 500000 },
        "description": { "type": "string", "maxLength": 2000 },
        "verified": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "name", "shopType", "city", "phone"]
    },
    "ShopProduct": {
      "title": "ShopProduct",
      "description": "Product item in a shop catalog with availability state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "image": { "type": "string", "maxLength": 500000 },
        "status": { "type": "string", "enum": ["disponivel", "esgotado"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "shopId", "title", "price", "status"]
    },
    "ShopReview": {
      "title": "ShopReview",
      "description": "Customer rating and review for a shop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string", "maxLength": 100 },
        "userUsername": { "type": "string", "maxLength": 50 },
        "userAvatar": { "type": "string", "maxLength": 500000 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "shopId", "userId", "rating", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with avatar, cover photo, bio, city, listings"
    },
    "/users/{userId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Buyer reviews and star ratings left for this seller"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Real product listings created by real users"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Social comments and questions on listings"
    },
    "/shops/{shopId}": {
      "schema": "Shop",
      "description": "Shop and business profiles with delivery, contact, hours"
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": "ShopProduct",
      "description": "Catalog of products belonging to a shop"
    },
    "/shops/{shopId}/reviews/{reviewId}": {
      "schema": "ShopReview",
      "description": "Customer reviews and 1-5 star ratings for a shop"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Reports submitted by users against suspicious content"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct message threads between users"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages between buyers and sellers"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notifications for a specific user"
    }
  }
}
