rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isSignedIn(); // Allow updating review rating aggregations
      allow delete: if isOwner(userId);

      // Reviews left by buyers for this seller
      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().buyerId == request.auth.uid;
        allow update, delete: if isSignedIn() && existing().buyerId == request.auth.uid;
      }
    }

    // Posts / Listings
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
      allow update: if isSignedIn() && (
        existing().sellerId == request.auth.uid ||
        // Allow liking / unliking / commenting / marking completed updates
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy', 'commentsCount', 'status', 'buyerId'])
      );
      allow delete: if isSignedIn() && existing().sellerId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && existing().authorId == request.auth.uid;
      }
    }

    // Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        request.auth.uid in existing().participantIds
      );
      allow create: if isSignedIn() && (
        request.auth.uid in incoming().participantIds
      );
      allow update: if isSignedIn() && (
        request.auth.uid in existing().participantIds
      );
      allow delete: if isSignedIn() && (
        request.auth.uid in existing().participantIds
      );

      // Messages in conversation
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
        allow update, delete: if isSignedIn() && existing().senderId == request.auth.uid;
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
